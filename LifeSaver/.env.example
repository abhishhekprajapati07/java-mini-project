# ============================================================================
# LifeSaver - Environment Variables Configuration Template
# ============================================================================
# Copy this file to .env and adjust variables for your local or cloud environment.
# NEVER commit real credentials or .env files with actual secrets to git!
# ============================================================================

# Database Configuration (MySQL / MariaDB)
DB_URL=jdbc:mysql://localhost:3306/lifesaver_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Backend Server Port
SERVER_PORT=8080

# CORS Allowed Origins (Comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default Admin Bootstrap Credentials (Used only on initial startup if no admin exists)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=AdminPassword@123
DEFAULT_ADMIN_EMAIL=admin@lifesaver.demo
DEFAULT_ADMIN_NAME=System Administrator

# Frontend API URL (Used by React Vite)
VITE_API_BASE_URL=http://localhost:8080/api
